# --- Dashboard login (sirf aap) ---
APP_PASSWORD=apna-strong-password
# Random lamba string: `openssl rand -hex 32`
SESSION_SECRET=

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://xxxx.supabase.co
# service_role key: sirf server par use hoti hai, browser tak kabhi nahi jaati
SUPABASE_SERVICE_ROLE_KEY=

# --- Email bhejne ke liye SMTP (Gmail: App Password banao) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aapka@gmail.com
SMTP_PASS=gmail-app-password
FROM_NAME=Aapka Naam

# --- Templates me {my_name} aur {my_portfolio} ---
MY_NAME=Aapka Naam
MY_PORTFOLIO=https://aapka-portfolio.com

# --- Limits (optional) ---
BATCH_SIZE=20
DAILY_LIMIT=60
FOLLOWUP_DAYS=4
MAX_FOLLOWUPS=1

# Website par number bina country code ho aur website se desh pata na chale (.com) tab yeh lagta hai — India = 91
DEFAULT_COUNTRY_CODE=91
